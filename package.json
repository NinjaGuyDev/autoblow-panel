{
  "name": "autoblow-panel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "tsx watch server/index.ts",
    "dev": "concurrently -n \"frontend,backend\" -c \"blue,green\" \"npm:dev:frontend\" \"npm:dev:backend\"",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.scripts.json",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "build:server": "tsc -p tsconfig.server.build.json --outDir dist/server --noEmit false",
    "build:electron": "tsc -p tsconfig.electron.json && npm run build:preload",
    "build:desktop": "npm run typecheck && vite build && npm run build:server && npm run build:electron",
    "dev:desktop": "npm run build:electron && concurrently -n \"vite,backend,electron\" -c \"blue,green,magenta\" \"npm:dev:frontend\" \"npm:dev:backend\" \"npm:dev:electron\"",
    "dev:electron": "ELECTRON_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dist": "npm run build:desktop && electron-builder",
    "dist:dir": "npm run build:desktop && electron-builder --dir",
    "build:preload": "tsc electron/preload.ts --outDir dist-electron --module commonjs --moduleResolution node --target ES2023 --types node --strict --skipLibCheck && node -e \"require('fs').renameSync('dist-electron/preload.js','dist-electron/preload.cjs')\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@xsense/autoblow-sdk": "^2.1.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dexie": "^4.3.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.563.0",
    "multer": "^2.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-dropzone": "^14.4.0",
    "react-player": "^3.4.0",
    "tailwind-merge": "^3.4.0",
    "use-debounce": "^10.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/ui": "^4.0.18",
    "concurrently": "^9.2.1",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  },
  "description": "Local-first desktop and web app for controlling the Autoblow AI Ultra device.",
  "author": "NinjaGuyDev",
  "license": "MIT",
  "main": "dist-electron/main.js"
}
